---
import Reveal from "../animations/Reveal.astro";
---

<section class="relative overflow-hidden border-t border-line py-[clamp(7rem,12vw,11rem)] max-[600px]:py-[5.5rem]">
  <div class="mx-auto w-[min(1200px,calc(100%-3rem))] max-[600px]:w-[min(100%-2rem,1200px)]">
    <Reveal>
      <div class="section-number mb-[clamp(3.5rem,7vw,6rem)] flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.18em] max-[600px]:mb-12">
        <span class="text-muted">01</span><span class="text-ink">About</span>
      </div>
    </Reveal>

    <div class="grid grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)] items-start gap-[clamp(3rem,8vw,9rem)] max-[900px]:grid-cols-1 max-[900px]:gap-14">
      <Reveal>
        <h2 class="m-0 max-w-[850px] text-[clamp(2.8rem,6vw,5.8rem)] font-extrabold leading-[0.98] tracking-[-0.055em] text-balance max-[600px]:text-[clamp(2.5rem,12vw,4rem)] max-[600px]:leading-none">
          I build software to solve practical problems.
        </h2>
      </Reveal>

      <Reveal delay={150}>
        <div class="max-w-[390px] pt-[0.6rem] max-[900px]:max-w-[600px] max-[900px]:pt-0">
          <p class="mb-10 text-[clamp(1rem,1.2vw,1.15rem)] leading-[1.8] text-muted max-[600px]:text-base max-[600px]:leading-[1.75]">
            I'm a software developer interested in building useful applications and understanding how technology works from the frontend to the backend.
          </p>
          <a href="/about" class="about-link relative inline-flex items-center gap-[0.7rem] pb-2 text-xs font-extrabold uppercase tracking-[0.14em] text-ink transition-all duration-300 hover:gap-5">
            More about me →
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .section-number span:last-child { color: var(--text-main); }
  .section-number::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
  .about-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform-origin: right;
    transition: transform 0.35s ease;
  }
  .about-link:hover::after { transform: scaleX(0); transform-origin: left; }
</style>
