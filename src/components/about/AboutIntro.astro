---
import Reveal from "../animations/Reveal.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class="relative overflow-hidden border-t border-line py-[clamp(7rem,12vw,11rem)] max-[600px]:py-[5.5rem]">
  <div class="mx-auto w-[min(1200px,calc(100%-3rem))] max-[600px]:w-[min(100%-2rem,1200px)]">
    <Reveal>
      <div class="section-number mb-[clamp(3.5rem,7vw,6rem)] flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.18em] max-[600px]:mb-12">
        <span class="text-muted">01</span><span class="text-ink">About</span>
      </div>
    </Reveal>

    <div class="grid grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)] items-start gap-[clamp(3rem,8vw,9rem)] max-[900px]:grid-cols-1 max-[900px]:gap-14">
      <Reveal>
        <h2 class="m-0 max-w-[850px] text-[clamp(2.4rem,4.8vw,4.6rem)] font-extrabold leading-[1] tracking-[-0.05em] text-balance max-[600px]:text-[clamp(2.2rem,10vw,3.5rem)] max-[600px]:leading-[1.02]">
          {compact ? "Building thoughtful digital tools." : "I build software to solve practical problems."}
        </h2>
      </Reveal>

      <Reveal delay={150}>
        <div class="max-w-[390px] pt-[0.6rem] max-[900px]:max-w-[600px] max-[900px]:pt-0">
          <p class="mb-10 text-[clamp(1rem,1.15vw,1.15rem)] leading-[1.8] text-muted max-[600px]:text-base max-[600px]:leading-[1.75]">
            {compact ? "I'm a software developer passionate about building performant, scalable applications and solving complex problems with technology." : "I’m a self-taught software developer and lifelong learner who enjoys adapting to new environments, technologies, and challenges. I believe that becoming a better developer requires continuous curiosity, discipline, and a willingness to learn beyond what is already familiar. I’m comfortable working independently, taking responsibility for my own growth, and exploring new technologies through hands-on projects and problem solving. At the same time, I value collaboration and enjoy working with others, sharing ideas, learning from different perspectives, and contributing toward a common goal. I approach unfamiliar situations with an open mind and see challenges as opportunities to grow, improve, and build better solutions."}
          </p>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .section-number span:last-child { color: var(--text-main); }
  .section-number::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
</style>
