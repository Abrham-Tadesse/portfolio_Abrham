---
import Reveal from "../animations/Reveal.astro"
---

<section class="about-preview">
  <div class="container">

  <Reveal>
      <div class="section-number">
        <span>01</span>
        <span>About</span>
      </div>
    </Reveal>

    <div class="about-content">

     <Reveal>
        <h2>
          I build software to solve practical problems.
        </h2>
      </Reveal>

           <Reveal delay={150}>
        <div class="about-text">

          <p>
            I'm a software developer interested in building
            useful applications and understanding how
            technology works from the frontend to the backend.
          </p>

          <a href="/about" class="about-link">
            More about me →
          </a>

        </div>
      </Reveal>
    </div>

  </div>
</section>


<style>
  .about-preview {
    padding: 10rem 0;
    border-top: 1px solid var(--border-color);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .section-number span:first-child {
    color: var(--text-muted);
  }

  .about-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .about-text p {
    margin: 0 0 2rem;
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-main);
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 2px solid var(--text-main);
    padding-bottom: 0.25rem;
    transition: gap 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-link:hover {
    gap: 1.2rem;
  }

  @media (max-width: 800px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>