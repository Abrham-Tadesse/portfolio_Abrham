---
import Reveal from "../animations/Reveal.astro"
---

<section class="about-preview">
  <div class="container">

  <Reveal>
      <div class="section-number">
        <span>01</span>
        <span>About</span>
      </div>
    </Reveal>

    <div class="about-content">

     <Reveal>
        <h2>
          I build software to solve practical problems.
        </h2>
      </Reveal>

           <Reveal delay={150}>
        <div class="about-text">

          <p>
            I'm a software developer interested in building
            useful applications and understanding how
            technology works from the frontend to the backend.
          </p>

          <a href="/about" class="about-link">
            More about me →
          </a>

        </div>
      </Reveal>
    </div>

  </div>
</section>





<style>
  .about-preview {
    position: relative;
    padding: clamp(7rem, 12vw, 11rem) 0;
    border-top: 1px solid var(--border-color, #dcdcd6);
    overflow: hidden;
  }

  .container {
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .section-number::after {
    content: "";
    width: 3rem;
    height: 1px;
    background: var(--border-color, #dcdcd6);
  }

  .section-number span:first-child {
    color: var(--text-muted, #77776f);
  }

  .section-number span:last-child {
    color: var(--text-main, #0e0e0e);
  }

  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: start;
  }

  h2 {
    max-width: 850px;
    margin: 0;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: clamp(2.8rem, 6vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 800;

    text-wrap: balance;
  }

  .about-text {
    max-width: 390px;
    padding-top: 0.6rem;
  }

  .about-text p {
    margin: 0 0 2.5rem;

    font-family: var(--font-body, inherit);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.8;
    color: var(--text-muted, #5f5f59);
  }

  .about-link {
    position: relative;

    display: inline-flex;
    align-items: center;
    gap: 0.7rem;

    padding-bottom: 0.5rem;

    color: var(--text-main, #0e0e0e);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;

    transition:
      gap 0.35s ease,
      color 0.35s ease;
  }

  .about-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform-origin: right;
    transform: scaleX(1);

    transition: transform 0.35s ease;
  }

  .about-link:hover {
    gap: 1.25rem;
  }

  .about-link:hover::after {
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-width: 900px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .about-text {
      max-width: 600px;
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .about-preview {
      padding: 5.5rem 0;
    }

    .container {
      width: min(100% - 2rem, 1200px);
    }

    .section-number {
      margin-bottom: 3rem;
    }

    h2 {
      font-size: clamp(2.5rem, 12vw, 4rem);
      line-height: 1;
    }

    .about-text p {
      font-size: 1rem;
      line-height: 1.75;
    }
  }
</style>