---
import { skillGroups } from "../../data/skills";
import Reveal from "../animations/Reveal.astro";
---

<section class="skills">
  <div class="container">
<Reveal>
  <div class="section-number">
    <span>02</span>
    <span>Skills</span>
  </div>
</Reveal>

    <div class="skills-header">
    <Reveal delay={100}>
  <h2>Technologies I work with.</h2>
</Reveal>

     <Reveal delay={200}>
  <p>
    Technologies and tools I use to build software.
  </p>
</Reveal>
    </div>


   
    <div class="skills-list">

      {skillGroups.map((group) => (
         <Reveal delay={100}>
        <div class="skill-group">

          <h3>
            {group.category}
          </h3>

          <div class="skill-items">

            {group.skills.map((skill) => (
              <span>{skill}</span>
            ))}

          </div>

        </div>
        </Reveal>
      ))}

    </div>

  </div>
</section>





<style>
  .skills {
    padding: 11rem 0;
    border-top: 1px solid #d8d8d5;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-bottom: 5rem;

    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .section-number span:first-child {
    color: #888;
  }

  .skills-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;

    margin-bottom: 7rem;
  }

  .skills-header h2 {
    margin: 0;

    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .skills-header p {
    max-width: 500px;
    margin: 0;

    font-size: 1.05rem;
    line-height: 1.85;
  }

  .skills-list {
    border-top: 1px solid #111;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;

    padding: 2.5rem 0;

    border-bottom: 1px solid #d8d8d5;
  }

  .skill-group h3 {
    margin: 0;

    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-items span {
    padding: 0.55rem 0.8rem;

    border: 1px solid #cfcfcb;

    font-size: 0.85rem;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .skill-items span:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  @media (max-width: 800px) {
    .skills {
      padding: 8rem 0;
    }

    .skills-header {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .skill-group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1rem;
    }

    .skills {
      padding: 7rem 0;
    }

    .section-number {
      margin-bottom: 3rem;
    }

    .skills-header h2 {
      font-size: clamp(3rem, 13vw, 5rem);
    }
  }
</style>