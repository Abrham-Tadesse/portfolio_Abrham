---
import { skillGroups } from "../../data/skills";
import Reveal from "../animations/Reveal.astro";
---

<section class="skills">
  <div class="container">
<Reveal>
  <div class="section-number">
    <span>02</span>
    <span>Skills</span>
  </div>
</Reveal>

    <div class="skills-header">
    <Reveal delay={100}>
  <h2>Technologies I work with.</h2>
</Reveal>

     <Reveal delay={200}>
  <p>
    Technologies and tools I use to build software.
  </p>
</Reveal>
    </div>


   
    <div class="skills-list">

      {skillGroups.map((group) => (
         <Reveal delay={100}>
        <div class="skill-group">

          <h3>
            {group.category}
          </h3>

          <div class="skill-items">

            {group.skills.map((skill) => (
              <span>{skill}</span>
            ))}

          </div>

        </div>
        </Reveal>
      ))}

    </div>

  </div>
</section>



<style>
  .skills {
    padding: 10rem 0;
    border-top: 1px solid var(--border-color);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .skills-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    margin-bottom: 6rem;
  }

  .skills-header h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .skills-header p {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-muted);
  }

  .skills-list {
    border-top: 1px solid var(--border-dark);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .skill-group h3 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-items span {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-color);
    font-size: 0.85rem;
    font-weight: 500;
    background: #ebebe5;
    transition: all 0.25s ease;
  }

  .skill-items span:hover {
    background: var(--text-main);
    color: var(--bg-color);
    border-color: var(--text-main);
  }

  @media (max-width: 800px) {
    .skills-header, .skill-group {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>