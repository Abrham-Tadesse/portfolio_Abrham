---
import { skillGroups } from "../../data/skills";
import Reveal from "../animations/Reveal.astro";
---

<section class="relative overflow-hidden border-t border-line py-[clamp(7rem,12vw,11rem)] max-[650px]:py-[5.5rem]">
  <div class="mx-auto w-[min(1200px,calc(100%-3rem))] max-[650px]:w-[min(100%-2rem,1200px)]">
    <Reveal>
      <div class="section-number mb-[clamp(3.5rem,7vw,6rem)] flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.18em] max-[650px]:mb-12">
        <span class="text-muted">02</span><span class="text-ink">Skills</span>
      </div>
    </Reveal>

    <div class="mb-[clamp(4rem,8vw,7rem)] grid grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)] items-start gap-[clamp(3rem,8vw,9rem)] max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[650px]:mb-16">
      <Reveal delay={100}>
        <h2 class="m-0 max-w-[800px] text-[clamp(2.8rem,6vw,5.8rem)] font-extrabold leading-[0.98] tracking-[-0.055em] text-balance max-[650px]:text-[clamp(2.5rem,12vw,4rem)]">Technologies I work with.</h2>
      </Reveal>
      <Reveal delay={200}>
        <p class="max-w-[380px] pt-[0.6rem] text-[clamp(1rem,1.2vw,1.15rem)] leading-[1.8] text-muted max-[900px]:max-w-[600px] max-[900px]:pt-0">Technologies and tools I use to build software.</p>
      </Reveal>
    </div>

    <div class="border-t border-ink">
      {skillGroups.map((group) => (
        <Reveal delay={100}>
          <div class="skill-group group grid grid-cols-[220px_minmax(0,1fr)] gap-[clamp(2rem,5vw,5rem)] border-b border-line py-10 transition-[padding] duration-300 hover:pl-2 max-[900px]:grid-cols-[170px_minmax(0,1fr)] max-[900px]:gap-8 max-[650px]:grid-cols-1 max-[650px]:gap-6 max-[650px]:py-8">
            <h3 class="skill-category relative m-0 font-heading text-[0.72rem] font-extrabold uppercase leading-[1.4] tracking-[0.15em] text-muted max-[650px]:text-[0.68rem]">{group.category}</h3>
            <div class="flex flex-wrap items-start gap-x-5 gap-y-2">
              {group.skills.map((skill) => (
                <span class="skill-item relative inline-flex items-center text-[clamp(1rem,1.5vw,1.25rem)] font-semibold leading-[1.5] text-ink transition duration-200 hover:-translate-y-0.5 hover:text-muted max-[650px]:mr-0 max-[650px]:text-base">{skill}</span>
              ))}
            </div>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<style>
  .section-number::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
  .section-number span:last-child { color: var(--text-main); }
  .skill-category::before { content: "—"; margin-right: 0.6rem; color: var(--text-main); }
  .skill-item:not(:last-child)::after { content: "·"; position: absolute; right: -0.85rem; color: #999990; }
</style>
