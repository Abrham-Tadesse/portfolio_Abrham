---
---

<section class="contact-cta">
  <div class="container">

    <p class="eyebrow">Contact</p>

    <h2>
      Have a project in mind?
    </h2>

    <p class="description">
      I'm interested in building useful software, solving real problems,
      and working on challenging technical projects.
    </p>

    <a href="/contact" class="contact-link">
      Get in touch →
    </a>

  </div>
</section>


<style>
  .contact-cta {
    padding: 10rem 0;
    border-top: 1px solid var(--border-color);
    background: var(--text-main);
    color: var(--bg-color);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #888;
  }

  h2 {
    max-width: 800px;
    margin-bottom: 2rem;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .description {
    max-width: 600px;
    margin-bottom: 3rem;
    font-size: 1.15rem;
    line-height: 1.85;
    color: #bbb;
  }

  .contact-link {
    display: inline-block;
    padding: 1.1rem 2.2rem;
    border: 1px solid var(--bg-color);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all 0.3s ease;
  }

  .contact-link:hover {
    background: var(--bg-color);
    color: var(--text-main);
  }
</style>