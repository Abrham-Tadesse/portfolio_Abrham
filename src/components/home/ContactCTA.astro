<section class="contact-cta">
  <div class="container">

    <p class="eyebrow">Contact</p>

    <h2>
      Have a project in mind?
    </h2>

    <p class="description">
      I'm interested in building useful software, solving real problems,
      and working on challenging technical projects.
    </p>

    <a href="/contact" class="contact-link">
      Get in touch →
    </a>

  </div>
</section>

<style>
  .contact-cta {
    padding: 8rem 0;
    border-top: 1px solid #ddd;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h2 {
    max-width: 800px;
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.05;
  }

  .description {
    max-width: 650px;
    margin-bottom: 2rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .contact-link {
    display: inline-block;
    font-weight: 700;
  }

  .contact-link:hover {
    opacity: 0.6;
  }
</style>