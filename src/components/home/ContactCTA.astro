---

<section class="contact-cta relative overflow-hidden bg-ink py-[clamp(8rem,15vw,13rem)] text-paper max-[650px]:py-28">
  <div class="relative z-10 mx-auto w-[min(1000px,calc(100%-3rem))] max-[650px]:w-[min(100%-2rem,1000px)]">
    <p class="eyebrow mb-8 flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.2em] text-paper/50 max-[650px]:mb-6">Contact</p>
    <h2 class="mb-10 max-w-[850px] text-[clamp(3.2rem,8vw,7.5rem)] font-extrabold leading-[0.92] tracking-[-0.06em] text-balance text-paper max-[650px]:mb-8 max-[650px]:text-[clamp(3rem,15vw,5rem)] max-[650px]:leading-[0.94]">Have a project in mind?</h2>
    <p class="mb-14 max-w-[570px] text-[clamp(1rem,1.25vw,1.15rem)] leading-[1.85] text-paper/60 max-[650px]:mb-12 max-[650px]:text-base max-[650px]:leading-[1.75]">
      I'm interested in building useful software, solving real problems, and working on challenging technical projects.
    </p>
    <a href="/contact" class="contact-link relative inline-flex items-center gap-3 pb-[0.65rem] font-heading text-xs font-extrabold uppercase tracking-[0.14em] text-paper transition-all duration-300 hover:gap-5">
      Get in touch →
    </a>
  </div>
</section>

<style>
  .contact-cta::before {
    content: "";
    position: absolute;
    top: 0;
    right: 8%;
    width: 1px;
    height: 100%;
    background: rgb(244 244 240 / 8%);
  }
  .contact-cta::after {
    content: "";
    position: absolute;
    top: 15%;
    right: -8rem;
    width: 22rem;
    height: 22rem;
    border: 1px solid rgb(244 244 240 / 8%);
    border-radius: 50%;
    pointer-events: none;
  }
  .eyebrow::after {
    content: "";
    width: 3rem;
    height: 1px;
    background: rgb(244 244 240 / 25%);
  }
  .contact-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform-origin: right;
    transition: transform 0.35s ease;
  }
  .contact-link:hover::after { transform: scaleX(0); transform-origin: left; }
  @media (max-width: 650px) {
    .contact-cta::before { right: 5%; }
    .contact-cta::after { top: 5%; right: -7rem; width: 14rem; height: 14rem; }
  }
  @media (prefers-reduced-motion: reduce) { .contact-link, .contact-link::after { transition: none; } }
</style>
