---
import { projects } from "../../data/projects";
---

<section class="featured-projects">
  <div class="container">

    <div class="section-number">
      <span>03</span>
      <span>Selected Work</span>
    </div>

    <div class="section-intro">
      <h2>
        Projects I've built.
      </h2>

      <p>
        A selection of applications I've developed while learning,
        experimenting, and solving practical problems.
      </p>
    </div>

    <div class="projects-list">

      {
        projects
          .filter((project) => project.featured)
          .map((project, index) => (
            <article class="project">

              <div class="project-number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="project-main">

                <div class="project-heading">

                  <h3>
                    {project.title}
                  </h3>

                  <p>
                    {project.description}
                  </p>

                </div>

                <div class="project-details">

                  <div class="technologies">
                    {project.technologies.map((technology) => (
                      <span>{technology}</span>
                    ))}
                  </div>

                  <a
                    href={`/projects/${project.slug}`}
                    class="project-link"
                  >
                    View project
                    <span>→</span>
                  </a>

                </div>

              </div>

            </article>
          ))
      }

    </div>

    <div class="all-projects">
      <a href="/projects">
        View all projects
        <span>→</span>
      </a>
    </div>

  </div>
</section>





<style>
  .featured-projects {
    padding: 11rem 0;
    border-top: 1px solid #d8d8d5;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-bottom: 5rem;

    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .section-number span:first-child {
    color: #888;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;

    margin-bottom: 7rem;
  }

  .section-intro h2 {
    margin: 0;

    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .section-intro p {
    max-width: 500px;
    margin: 0;

    font-size: 1.05rem;
    line-height: 1.85;
  }

  .projects-list {
    border-top: 1px solid #111;
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr;

    padding: 3.5rem 0;

    border-bottom: 1px solid #d8d8d5;

    transition:
      padding 0.3s ease,
      background 0.3s ease;
  }

  .project:hover {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    background: #eeeeeb;
  }

  .project-number {
    color: #888;

    font-size: 0.75rem;
    font-weight: 700;
  }

  .project-main {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 4rem;
  }

  .project-heading h3 {
    margin: 0 0 1rem;

    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .project-heading p {
    max-width: 600px;
    margin: 0;

    font-size: 1rem;
    line-height: 1.8;
  }

  .project-details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .technologies span {
    padding: 0.4rem 0.65rem;

    border: 1px solid #cfcfcb;

    font-size: 0.75rem;
  }

  .project-link,
  .all-projects a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;

    font-weight: 700;

    transition: gap 0.25s ease;
  }

  .project-link:hover,
  .all-projects a:hover {
    gap: 1.2rem;
  }

  .all-projects {
    margin-top: 3rem;
  }

  .all-projects a {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #111;
  }

  @media (max-width: 800px) {
    .featured-projects {
      padding: 8rem 0;
    }

    .section-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .project {
      grid-template-columns: 50px 1fr;
    }

    .project-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1rem;
    }

    .featured-projects {
      padding: 7rem 0;
    }

    .section-number {
      margin-bottom: 3rem;
    }

    .project {
      padding: 2.5rem 0;
    }

    .project:hover {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }

    .project-heading h3 {
      font-size: 2.2rem;
    }
  }
</style>