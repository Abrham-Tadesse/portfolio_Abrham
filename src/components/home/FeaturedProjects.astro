---
import { projects } from "../../data/projects";
---

<section class="featured-projects">
  <div class="container">

    <div class="section-number">
      <span>03</span>
      <span>Selected Work</span>
    </div>

    <div class="section-intro">
      <h2>
        Projects I've built.
      </h2>

      <p>
        A selection of applications I've developed while learning,
        experimenting, and solving practical problems.
      </p>
    </div>

    <div class="projects-list">

      {
        projects
          .filter((project) => project.featured)
          .map((project, index) => (
            <article class="project">

              <div class="project-number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="project-main">

                <div class="project-heading">

                  <h3>
                    {project.title}
                  </h3>

                  <p>
                    {project.description}
                  </p>

                </div>

                <div class="project-details">

                  <div class="technologies">
                    {project.technologies.map((technology) => (
                      <span>{technology}</span>
                    ))}
                  </div>

                  <a
                    href={`/projects/${project.slug}`}
                    class="project-link"
                  >
                    View project
                    <span>→</span>
                  </a>

                </div>

              </div>

            </article>
          ))
      }

    </div>

    <div class="all-projects">
      <a href="/projects">
        View all projects
        <span>→</span>
      </a>
    </div>

  </div>
</section>




<style>
  .featured-projects {
    padding: 10rem 0;
    border-top: 1px solid var(--border-color);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;

    /* Scroll reveal */
    animation: fadeUp linear both;
    animation-timeline: view();
    animation-range: entry 10% cover 20%;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    margin-bottom: 6rem;

    /* Scroll reveal */
    animation: fadeUp linear both;
    animation-timeline: view();
    animation-range: entry 10% cover 25%;
  }

  .section-intro h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .section-intro p {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-muted);
  }

  .projects-list {
    border-top: 1px solid var(--border-dark);
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr;
    padding: 3.5rem 1rem;
    border-bottom: 1px solid var(--border-color);
    transition: background 0.3s ease, transform 0.3s ease;

    /* Individual project scroll reveal */
    animation: fadeUp linear both;
    animation-timeline: view();
    animation-range: entry 5% cover 20%;
  }

  .project:hover {
    background: #ebebe5;
  }

  .project-number {
    font-family: var(--font-heading);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .project-main {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 4rem;
  }

  .project-heading h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 3.5vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .project-heading p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .project-details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .technologies span {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-color);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-link, .all-projects a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: gap 0.25s ease;
  }

  .project-link:hover, .all-projects a:hover {
    gap: 1.2rem;
  }

  .all-projects {
    margin-top: 4rem;
    animation: fadeUp linear both;
    animation-timeline: view();
    animation-range: entry 10% cover 20%;
  }

  .all-projects a {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-dark);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 800px) {
    .section-intro, .project-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>