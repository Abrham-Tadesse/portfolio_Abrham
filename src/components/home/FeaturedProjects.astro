---
import { projects } from "../../data/projects";
---

<section class="relative overflow-hidden border-t border-line py-[clamp(7rem,12vw,11rem)] max-[650px]:py-[5.5rem]">
  <div class="mx-auto w-[min(1200px,calc(100%-3rem))] max-[650px]:w-[min(100%-2rem,1200px)]">
    <div class="section-number scroll-reveal mb-[clamp(3.5rem,7vw,6rem)] flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.18em] max-[650px]:mb-12">
      <span class="text-muted">03</span><span class="text-ink">Selected Work</span>
    </div>

    <div class="section-intro scroll-reveal mb-[clamp(4rem,8vw,7rem)] grid grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)] items-start gap-[clamp(3rem,8vw,9rem)] max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[650px]:mb-16">
      <h2 class="m-0 max-w-[850px] text-[clamp(2.8rem,6vw,5.8rem)] font-extrabold leading-[0.98] tracking-[-0.055em] text-balance max-[650px]:text-[clamp(2.5rem,12vw,4rem)]">Projects I've built.</h2>
      <p class="max-w-[390px] pt-[0.6rem] text-[clamp(1rem,1.2vw,1.15rem)] leading-[1.8] text-muted max-[900px]:max-w-[600px] max-[900px]:pt-0">
        A selection of applications I've developed while learning, experimenting, and solving practical problems.
      </p>
    </div>

    <div class="border-t border-ink">
      {projects.filter((project) => project.featured).map((project, index) => (
        <article class="project scroll-reveal group relative grid grid-cols-[80px_minmax(0,1fr)] border-b border-line px-4 py-[clamp(2.5rem,5vw,4.5rem)] transition-[padding,color] duration-300 max-[650px]:grid-cols-1 max-[650px]:gap-6 max-[650px]:px-0 max-[650px]:py-10 max-[650px]:hover:px-4">
          <div class="absolute inset-0 z-0 origin-bottom scale-y-0 bg-ink transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-y-100"></div>
          <div class="project-number relative z-10 pt-1 font-heading text-[0.72rem] font-extrabold tracking-[0.1em] text-muted transition-colors duration-300 group-hover:text-paper/55">
            {String(index + 1).padStart(2, "0")}
          </div>

          <div class="relative z-10 grid grid-cols-[minmax(0,1fr)_minmax(220px,0.7fr)] gap-[clamp(3rem,7vw,7rem)] max-[900px]:grid-cols-1 max-[900px]:gap-10">
            <div>
              <h3 class="mb-5 text-[clamp(2rem,3.8vw,3.5rem)] font-extrabold leading-[0.98] tracking-[-0.045em] transition-colors duration-300 group-hover:text-paper">{project.title}</h3>
              <p class="max-w-[600px] text-base leading-[1.8] text-muted transition-colors duration-300 group-hover:text-paper/65">{project.description}</p>
            </div>

            <div class="flex flex-col items-start justify-between gap-10 max-[900px]:gap-8">
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                {project.technologies.map((technology) => (
                  <span class="technology relative text-[0.7rem] font-bold uppercase tracking-[0.1em] text-muted transition-colors duration-300 group-hover:text-paper/65">{technology}</span>
                ))}
              </div>
              <a href={`/projects/${project.slug}`} class="project-link relative inline-flex items-center gap-3 pb-2 text-[0.72rem] font-extrabold uppercase tracking-[0.13em] transition-[gap] duration-300 hover:gap-5">
                View project <span>→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="all-projects scroll-reveal mt-16">
      <a href="/projects" class="all-projects-link relative inline-flex items-center gap-3 pb-2 text-[0.72rem] font-extrabold uppercase tracking-[0.13em] transition-[gap] duration-300 hover:gap-5">
        View all projects <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .section-number::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
  .section-number span:last-child { color: var(--text-main); }
  .technology:not(:last-child)::after { content: "·"; position: absolute; right: -0.65rem; color: var(--border-color); }
  .project-link::after, .all-projects-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform-origin: right;
    transition: transform 0.35s ease;
  }
  .project-link:hover::after, .all-projects-link:hover::after { transform: scaleX(0); transform-origin: left; }
  .scroll-reveal { animation: fadeUp linear both; animation-timeline: view(); animation-range: entry 10% cover 25%; }
  .project.scroll-reveal { animation-range: entry 5% cover 20%; }
  .all-projects.scroll-reveal { animation-range: entry 10% cover 20%; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
</style>
