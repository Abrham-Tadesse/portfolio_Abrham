---
interface Props {
  name: string;
  role: string;
  description: string;
}

const { name, role, description } = Astro.props;
---

<section class="hero relative flex min-h-svh items-center overflow-hidden border-b border-line py-28 pb-16 max-[900px]:min-h-0 max-[900px]:py-32 max-[600px]:py-28 max-[600px]:pb-16">
  <div class="hero-container relative z-10 mx-auto grid w-full max-w-[1200px] grid-cols-[180px_minmax(0,1fr)] items-start gap-[clamp(2.5rem,5vw,4.5rem)] px-6 py-16 max-[900px]:grid-cols-[140px_minmax(0,1fr)] max-[900px]:gap-10 max-[600px]:grid-cols-[88px_minmax(0,1fr)] max-[600px]:gap-6 max-[600px]:px-4 max-[600px]:py-12">
    <div class="hero-image relative flex justify-start pt-1 animate-[imageReveal_1s_cubic-bezier(0.22,1,0.36,1)_200ms_both]">
      <div class="photo-placeholder relative h-[150px] w-[150px] overflow-hidden rounded-full border-2 border-ink bg-[#e8e8e2] max-[900px]:h-[120px] max-[900px]:w-[120px] max-[600px]:h-[88px] max-[600px]:w-[88px]">
        <img src="/images/profile/profile.jpg" alt="Portrait of Abrham Tadesse" class="absolute inset-0 h-full w-full object-cover object-[60%_center]" fetchpriority="high" />
      </div>
    </div>

    <div class="hero-content max-w-[760px] animate-[heroReveal_1s_cubic-bezier(0.22,1,0.36,1)_both] max-[900px]:max-w-full">
      <p class="intro mb-6 flex items-center gap-[0.9rem] text-xs font-extrabold uppercase tracking-[0.2em] text-muted">
        Hello, I'm
      </p>
      <h1 class="m-0 max-w-[900px] text-[clamp(4rem,9vw,8rem)] font-extrabold leading-[0.84] tracking-[-0.065em] text-ink max-[600px]:text-[clamp(3.5rem,17vw,5.5rem)]">{name}</h1>
      <h2 class="mt-7 font-sans text-[clamp(1.2rem,2.2vw,2rem)] font-medium leading-tight normal-case tracking-[-0.025em] text-muted max-[600px]:text-[1.2rem]">{role}</h2>
      <p class="mt-8 max-w-[570px] text-base leading-[1.9] text-muted max-[600px]:text-base">{description}</p>
      <div class="mt-11 flex flex-wrap gap-3 max-[600px]:flex-col max-[600px]:items-stretch">
        <a href="/projects" class="hero-button primary-button">View My Projects</a>
        <a href="/contact" class="hero-button secondary-button">Contact Me</a>
      </div>
    </div>

  </div>
</section>

<style>
  .hero::before {
    content: "01";
    position: absolute;
    top: 7rem;
    left: max(1.5rem, calc((100vw - 1200px) / 2));
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .intro::before {
    content: "";
    width: 35px;
    height: 1px;
    background: var(--border-dark);
  }

  .photo-placeholder {
    box-shadow: 0 12px 32px rgb(14 14 14 / 12%);
  }

  .hero-button {
    position: relative;
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--text-main);
    padding: 0.95rem 1.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.35s ease, background-color 0.35s ease, transform 0.35s var(--ease-out);
  }

  .hero-button::after {
    content: "→";
    margin-left: 0.7rem;
    font-size: 1rem;
    transition: transform 0.3s ease;
  }

  .primary-button { background: var(--text-main); color: var(--bg-color); }
  .secondary-button { background: transparent; color: var(--text-main); }
  .primary-button:hover { background: transparent; color: var(--text-main); }
  .secondary-button:hover { background: var(--text-main); color: var(--bg-color); }
  .hero-button:hover { transform: translateY(-4px); }
  .hero-button:hover::after { transform: translateX(4px); }

  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(45px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes imageReveal {
    from { opacity: 0; transform: translateX(45px) scale(0.96); }
    to { opacity: 1; transform: translateX(0) scale(1); }
  }

  @media (max-width: 900px) { .hero::before { top: 5rem; } }
  @media (max-width: 600px) { .hero::before { top: 5rem; left: 1rem; } .hero-button { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero-content, .hero-image { animation: none; } .hero-button, .hero-button::after { transition: none; } }
</style>
