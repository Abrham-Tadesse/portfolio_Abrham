---
interface Props {
  name: string;
  role: string;
  description: string;
}

const {
  name,
  role,
  description
} = Astro.props;
---

<section class="hero">
  <div class="hero-container">

    <div class="hero-content">

      <p class="intro">
        Hello, I'm
      </p>

      <h1>{name}</h1>

      <h2>{role}</h2>

      <p class="description">
        {description}
      </p>

      <div class="actions">
        <a href="/projects" class="primary-button">
          View My Projects
        </a>

        <a href="/contact" class="secondary-button">
          Contact Me
        </a>
      </div>

    </div>

    <div class="hero-image">
      <!-- <img src="" alt="">        replace this entirely with the next dev sectionn  -->
      <div class="photo-placeholder">
        <span>PHOTO</span>
      </div>
    </div>

  </div>
</section>


<style>
  .hero {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem 1.5rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    align-items: center;
    gap: 6rem;
  }

  .hero-content {
    max-width: 720px;
  }

  .intro {
    margin: 0 0 1rem;

    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;

    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
    font-weight: 800;
  }

  h2 {
    margin: 1.5rem 0 0;

    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .description {
    max-width: 620px;
    margin: 2rem 0 0;

    font-size: 1.1rem;
    line-height: 1.8;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-top: 2.5rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0.9rem 1.4rem;

    border: 1px solid #111;

    font-size: 0.9rem;
    font-weight: 700;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .primary-button {
    background: #111;
    color: #fff;
  }

  .secondary-button {
    background: transparent;
    color: #111;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-3px);
  }

  .primary-button:hover {
    background: transparent;
    color: #111;
  }

  .secondary-button:hover {
    background: #111;
    color: #fff;
  }

  /* PHOTO */

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .photo-placeholder {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #e9e9e6;

    border: 1px solid #111;

    position: relative;
    overflow: hidden;
  }

  .photo-placeholder::before {
    content: "";

    position: absolute;
    inset: 12px;

    border: 1px solid rgba(17, 17, 17, 0.25);
  }

  .photo-placeholder span {
    position: relative;

    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .hero-content {
      max-width: 800px;
    }

    .hero-image {
      justify-content: flex-start;
    }

    .photo-placeholder {
      max-width: 320px;
    }
  }

  @media (max-width: 600px) {
    .hero-container {
      padding: 5rem 1rem;
    }

    h1 {
      font-size: clamp(3.5rem, 17vw, 6rem);
    }

    h2 {
      margin-top: 1.25rem;
    }

    .description {
      font-size: 1rem;
    }

    .actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .photo-placeholder {
      max-width: 100%;
    }
  }
</style>