---
interface Props {
  name: string;
  role: string;
  description: string;
}

const {
  name,
  role,
  description
} = Astro.props;
---

<section class="hero">
  <div class="hero-container">

    <div class="hero-content">

      <p class="intro">
        Hello, I'm
      </p>

      <h1>{name}</h1>

      <h2>{role}</h2>

      <p class="description">
        {description}
      </p>

      <div class="actions">
        <a href="/projects" class="primary-button">
          View My Projects
        </a>

        <a href="/contact" class="secondary-button">
          Contact Me
        </a>
      </div>

    </div>

    <div class="hero-image">
      <!-- <img src="" alt="">        replace this entirely with the next dev sectionn  -->
      <div class="photo-placeholder">
        <span>PHOTO</span>
      </div>
    </div>

  </div>
</section>



<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 7rem 0 4rem;
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .hero::before {
    content: "01";
    position: absolute;
    top: 7rem;
    left: max(1.5rem, calc((100vw - 1200px) / 2));
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--text-muted);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-content {
    max-width: 760px;
    animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .intro::before {
    content: "";
    width: 35px;
    height: 1px;
    background: var(--border-dark);
  }

  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.84;
    letter-spacing: -0.065em;
    font-weight: 800;
    color: var(--text-main);
  }

  h2 {
    margin: 1.75rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 2.2vw, 2rem);
    line-height: 1.2;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: -0.025em;
    text-transform: none;
  }

  .description {
    max-width: 570px;
    margin: 2rem 0 0;
    font-size: 1rem;
    line-height: 1.9;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.75rem;
  }

  .primary-button,
  .secondary-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0.95rem 1.5rem;
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition:
      color 0.35s ease,
      background-color 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .primary-button {
    background: var(--text-main);
    color: var(--bg-color);
    border: 1px solid var(--text-main);
  }

  .secondary-button {
    background: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-dark);
  }

  .primary-button::after,
  .secondary-button::after {
    content: "→";
    margin-left: 0.7rem;
    font-size: 1rem;
    transition: transform 0.3s ease;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-4px);
  }

  .primary-button:hover {
    background: transparent;
    color: var(--text-main);
  }

  .secondary-button:hover {
    background: var(--text-main);
    color: var(--bg-color);
  }

  .primary-button:hover::after,
  .secondary-button:hover::after {
    transform: translateX(4px);
  }

  .hero-image {
    position: relative;
    display: flex;
    justify-content: center;
    animation: imageReveal 1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  .hero-image::before {
    content: "PROFILE";
    position: absolute;
    top: -1.75rem;
    right: 0;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--text-muted);
  }

  .photo-placeholder {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #e8e8e2;
    border: 1px solid var(--border-dark);
  }

  .photo-placeholder::before {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(14, 14, 14, 0.16);
    transition: inset 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .photo-placeholder::after {
    content: "";
    position: absolute;
    width: 160%;
    height: 1px;
    background: rgba(14, 14, 14, 0.12);
    transform: rotate(-45deg);
  }

  .photo-placeholder:hover::before {
    inset: 20px;
  }

  .photo-placeholder span {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(45px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes imageReveal {
    from {
      opacity: 0;
      transform: translateX(45px) scale(0.96);
    }

    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding: 8rem 0 5rem;
    }

    .hero::before {
      top: 5rem;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-image {
      justify-content: flex-start;
    }

    .photo-placeholder {
      max-width: 320px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 7rem 0 4rem;
    }

    .hero-container {
      padding: 3rem 1rem;
      gap: 3.5rem;
    }

    .hero::before {
      left: 1rem;
    }

    h1 {
      font-size: clamp(3.5rem, 17vw, 5.5rem);
    }

    h2 {
      font-size: 1.2rem;
    }

    .description {
      font-size: 0.95rem;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .primary-button,
    .secondary-button {
      width: 100%;
    }

    .hero-image {
      justify-content: center;
    }

    .photo-placeholder {
      max-width: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-image {
      animation: none;
    }

    .primary-button,
    .secondary-button,
    .photo-placeholder,
    .photo-placeholder::before,
    .primary-button::after,
    .secondary-button::after {
      transition: none;
    }
  }
</style>