---
interface Props {
  name: string;
  role: string;
  description: string;
}

const {
  name,
  role,
  description
} = Astro.props;
---

<section class="hero">
  <div class="hero-container">

    <div class="hero-content">

      <p class="intro">
        Hello, I'm
      </p>

      <h1>{name}</h1>

      <h2>{role}</h2>

      <p class="description">
        {description}
      </p>

      <div class="actions">
        <a href="/projects" class="primary-button">
          View My Projects
        </a>

        <a href="/contact" class="secondary-button">
          Contact Me
        </a>
      </div>

    </div>

    <div class="hero-image">
      <!-- <img src="" alt="">        replace this entirely with the next dev sectionn  -->
      <div class="photo-placeholder">
        <span>PHOTO</span>
      </div>
    </div>

  </div>
</section>




<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 380px;
    align-items: center;
    gap: 5rem;
  }

  .hero-content {
    max-width: 720px;
  }

  .intro {
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 800;
    color: var(--text-main);
  }

  h2 {
    margin: 1.5rem 0 0;
    font-size: clamp(1.25rem, 2.5vw, 2.25rem);
    line-height: 1.1;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .description {
    max-width: 580px;
    margin: 2rem 0 0;
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-main);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
  }

  .primary-button {
    background: var(--text-main);
    color: var(--bg-color);
    border: 1px solid var(--text-main);
  }

  .secondary-button {
    background: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-dark);
  }

  .primary-button:hover {
    background: transparent;
    color: var(--text-main);
  }

  .secondary-button:hover {
    background: var(--text-main);
    color: var(--bg-color);
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .photo-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e8e2;
    border: 1px solid var(--border-dark);
    position: relative;
  }

  .photo-placeholder::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(14, 14, 14, 0.15);
  }

  .photo-placeholder span {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>