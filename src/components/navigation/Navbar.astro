<header class="navbar">
  <div class="navbar-container">

    <a href="/" class="logo">
      Your Name
    </a>

    <nav class="navigation" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/contact">Contact</a>
    </nav>

  </div>
</header>

<style>
  .navbar {
    width: 100%;
    border-bottom: 1px solid #e5e5e5;
    background: #595757;
    position:fixed;
    z-index: 20;
    padding: 3rem 1rem;
    

  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
    
  }
  
  .logo {
    color: #111111;
    font-size: 1.1rem;
    font-size: 2.3rem;
    font-weight: 800;
    text-decoration: none;
    position:fixed;
    left: 5%;
  }
  
  .navigation {
    display: flex;
    align-items: center;
    gap: 2rem;
    float: right;
    position: fixed;
    right: 10%;
    
  }

  .navigation a {
    color: #111111;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    /* float: right; */
    font-size: 1.5rem;
    }

  .navigation a:hover {
    opacity: 0.55;
  }

  @media (max-width: 600px) {
    .navbar-container {
      padding: 1rem;
    }

    .navigation {
      gap: 1rem;
    }

    .navigation a {
      font-size: 0.85rem;
    }
  }
</style>