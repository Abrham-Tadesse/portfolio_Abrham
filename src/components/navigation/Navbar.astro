---

<header class="navbar">
  <div class="navbar-container">
    <a href="/" class="logo">
      Abrham Tadesse
    </a>

    <nav class="navigation" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;

    width: 100%;

    background: rgba(244, 244, 240, 0.72);

    border-bottom: 1px solid rgba(220, 220, 214, 0.75);

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    transition:
      background-color 0.35s ease,
      border-color 0.35s ease;
  }

  .navbar-container {
    width: min(
      var(--container-width, 1200px),
      calc(100% - 3rem)
    );

    min-height: 76px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    position: relative;

    display: inline-flex;
    align-items: center;

    color: var(--text-main);

    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;

    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .logo:hover {
    opacity: 0.65;
    transform: translateY(-1px);
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .navigation a {
    position: relative;

    display: inline-flex;
    align-items: center;

    padding: 0.35rem 0;

    color: var(--text-main);

    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;

    text-transform: uppercase;
    letter-spacing: 0.14em;

    transition:
      color 0.25s ease,
      opacity 0.25s ease;
  }

  .navigation a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: 0;

    width: 100%;
    height: 1px;

    background: var(--text-main);

    transform: scaleX(0);
    transform-origin: right;

    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .navigation a:hover::after,
  .navigation a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .navigation a:focus-visible {
    outline: none;
  }

  @media (max-width: 650px) {
    .navbar-container {
      width: min(100% - 2rem, var(--container-width, 1200px));
      min-height: 68px;
    }

    .logo {
      font-size: 0.9rem;
    }

    .navigation {
      gap: 1rem;
    }

    .navigation a {
      font-size: 0.58rem;
      letter-spacing: 0.1em;
    }
  }

  @media (max-width: 430px) {
    .navigation {
      gap: 0.75rem;
    }

    .navigation a {
      font-size: 0.52rem;
    }

    .logo {
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .logo,
    .navigation a,
    .navigation a::after {
      transition: none;
    }
  }
</style>