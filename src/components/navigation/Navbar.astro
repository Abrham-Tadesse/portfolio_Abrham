<header class="fixed left-0 top-0 z-[100] w-full border-b border-line/75 bg-paper/75 backdrop-blur-2xl transition-colors duration-300">
  <div class="mx-auto flex min-h-[76px] w-[min(1200px,calc(100%-3rem))] items-center justify-between max-[650px]:min-h-[68px] max-[650px]:w-[min(100%-2rem,1200px)]">
    <a href="/" class="inline-flex items-center font-heading text-[1.05rem] font-extrabold uppercase leading-none tracking-[-0.035em] transition duration-200 hover:-translate-y-px hover:opacity-65 max-[650px]:text-[0.9rem] max-[430px]:text-[0.78rem]">
      Abrham Tadesse
    </a>

    <nav class="flex items-center gap-[clamp(1.5rem,3vw,2.75rem)] max-[650px]:gap-4 max-[430px]:gap-3" aria-label="Main navigation">
      <a class="nav-link" href="/">Home</a>
      <a class="nav-link" href="/about">About</a>
      <a class="nav-link" href="/projects">Projects</a>
      <a class="nav-link" href="/contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.25s ease, opacity 0.25s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 650px) {
    .nav-link { font-size: 0.58rem; letter-spacing: 0.1em; }
  }

  @media (max-width: 430px) {
    .nav-link { font-size: 0.52rem; }
  }
</style>
