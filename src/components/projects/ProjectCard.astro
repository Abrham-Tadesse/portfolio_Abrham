---
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">

  <div class="project-content">

    <p class="project-label">
      Project
    </p>

    <h2>
      {project.title}
    </h2>

    <p class="description">
      {project.description}
    </p>

    <div class="technologies">
      {project.technologies.map((technology) => (
        <span>{technology}</span>
      ))}
    </div>

    <div class="links">
      <a href={`/projects/${project.slug}`}>
        View Project →
      </a>

      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>
    </div>

  </div>

</article>

<style>
  .project-card {
    border: 1px solid #ddd;
    background: white;
    transition: transform 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
  }

  .project-content {
    padding: 2rem;
  }

  .project-label {
    margin-bottom: 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  .description {
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .technologies span {
    padding: 0.4rem 0.7rem;
    border: 1px solid #ddd;
    font-size: 0.8rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .links a {
    font-weight: 600;
  }

  .links a:hover {
    opacity: 0.6;
  }

  @media (max-width: 600px) {
    .project-content {
      padding: 1.5rem;
    }

    .links {
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>