---
interface Props {
  title: string;
  slug: string;
  description: string;
  technologies: string[];
  featured?: boolean;
}

const {
  title,
  slug,
  description,
  technologies,
  featured = false
} = Astro.props;
---

<article class="project-card">

  <div class="project-meta">
    <span>Project</span>

    {featured && (
      <span>Featured</span>
    )}
  </div>

  <div class="project-content">

    <h2>{title}</h2>

    <p>{description}</p>

    <div class="technologies">
      {technologies.map((technology) => (
        <span>{technology}</span>
      ))}
    </div>

    <a href={`/projects/${slug}`} class="project-link">
      View project
      <span>→</span>
    </a>

  </div>

</article>



<style>
  .project-card {
    position: relative;

    padding: clamp(3rem, 6vw, 5rem) clamp(0rem, 2vw, 1.5rem);

    border-bottom: 1px solid var(--border-color);

    background: transparent;

    transition:
      background-color 0.4s var(--ease-out, ease),
      padding-left 0.4s var(--ease-out, ease),
      padding-right 0.4s var(--ease-out, ease);
  }

  .project-card:hover {
    background: #ebebe5;

    padding-left: clamp(1rem, 2vw, 1.5rem);
    padding-right: clamp(1rem, 2vw, 1.5rem);
  }

  /* -------------------------
     Metadata
  ------------------------- */

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: clamp(2rem, 4vw, 3rem);

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.68rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .project-meta span:first-child {
    color: var(--text-muted);
  }

  .project-meta span:last-child {
    color: var(--text-main);
  }

  /* -------------------------
     Main content
  ------------------------- */

  .project-content {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);

    column-gap: clamp(3rem, 8vw, 8rem);

    align-items: end;
  }

  h2 {
    margin: 0 0 1.25rem;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 800;

    line-height: 0.95;
    letter-spacing: -0.055em;

    text-wrap: balance;

    transition: transform 0.4s var(--ease-out, ease);
  }

  .project-card:hover h2 {
    transform: translateX(0.2rem);
  }

  p {
    max-width: 650px;

    margin: 0;

    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.8;

    color: var(--text-muted);
  }

  /* -------------------------
     Technologies + link
  ------------------------- */

  .technologies {
    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem;

    margin-bottom: 2.5rem;
  }

  .technologies span {
    padding: 0.4rem 0.75rem;

    border: 1px solid var(--border-color);

    background: var(--bg-color);

    font-size: 0.65rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.08em;

    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .project-card:hover .technologies span {
    border-color: rgba(14, 14, 14, 0.2);
  }

  .project-link {
    position: relative;

    display: inline-flex;
    align-items: center;

    gap: 0.65rem;

    padding-bottom: 0.5rem;

    font-size: 0.7rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.13em;

    border-bottom: 1px solid var(--text-main);

    transition:
      gap 0.35s var(--ease-out, ease),
      opacity 0.25s ease;
  }

  .project-link span {
    font-size: 1rem;

    transition:
      transform 0.35s var(--ease-out, ease);
  }

  .project-link:hover {
    gap: 1.1rem;
  }

  .project-link:hover span {
    transform: translateX(0.15rem);
  }

  /* -------------------------
     Responsive
  ------------------------- */

  @media (max-width: 800px) {
    .project-content {
      grid-template-columns: 1fr;

      gap: 2.5rem;

      align-items: start;
    }

    .technologies {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 600px) {
    .project-card {
      padding: 3rem 0;
    }

    .project-card:hover {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .project-meta {
      margin-bottom: 2rem;
    }

    h2 {
      font-size: clamp(2.4rem, 12vw, 4rem);
    }

    p {
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .technologies span {
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    h2,
    .project-link,
    .project-link span {
      transition: none;
    }
  }
</style>