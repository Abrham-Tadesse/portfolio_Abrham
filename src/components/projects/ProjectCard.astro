---
interface Props {
  title: string;
  slug: string;
  description: string;
  technologies: string[];
  featured?: boolean;
}

const {
  title,
  slug,
  description,
  technologies,
  featured = false
} = Astro.props;
---

<article class="project-card">

  <div class="project-meta">
    <span>Project</span>

    {featured && (
      <span>Featured</span>
    )}
  </div>

  <div class="project-content">

    <h2>{title}</h2>

    <p>{description}</p>

    <div class="technologies">
      {technologies.map((technology) => (
        <span>{technology}</span>
      ))}
    </div>

    <a href={`/projects/${slug}`} class="project-link">
      View project
      <span>→</span>
    </a>

  </div>

</article>

<style>
  .project-card {
    padding: 3rem 0;
    border-top: 1px solid #ddd;
    transition:
      padding 0.3s ease,
      transform 0.3s ease;
  }

  .project-card:last-child {
    border-bottom: 1px solid #ddd;
  }

  .project-card:hover {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;

    margin-bottom: 2rem;

    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .project-meta span:last-child {
    color: #888;
  }

  .project-content {
    max-width: 850px;
  }

  h2 {
    margin: 0 0 1.25rem;

    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 650px;
    margin: 0 0 2rem;

    font-size: 1.05rem;
    line-height: 1.8;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    margin-bottom: 2rem;
  }

  .technologies span {
    padding: 0.4rem 0.65rem;

    border: 1px solid #ddd;

    font-size: 0.8rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;

    font-weight: 700;

    transition: gap 0.2s ease;
  }

  .project-link:hover {
    gap: 1.2rem;
  }

  @media (max-width: 600px) {
    .project-card {
      padding: 2rem 0;
    }

    .project-card:hover {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
</style>