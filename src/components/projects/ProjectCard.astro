---
interface Props {
  title: string;
  slug: string;
  description: string;
  technologies: string[];
  featured?: boolean;
}

const { title, slug, description, technologies, featured = false } = Astro.props;
---

<article class="group relative border-b border-line bg-transparent px-[clamp(0rem,2vw,1.5rem)] py-[clamp(3rem,6vw,5rem)] transition-[background-color,padding] duration-300 hover:bg-[#ebebe5] hover:px-[clamp(1rem,2vw,1.5rem)] max-[600px]:px-0 max-[600px]:py-12 max-[600px]:hover:px-3">
  <div class="mb-[clamp(2rem,4vw,3rem)] flex items-center justify-between font-heading text-[0.68rem] font-extrabold uppercase tracking-[0.16em]">
    <span class="text-muted">Project</span>
    {featured && <span class="text-ink">Featured</span>}
  </div>

  <div class="grid grid-cols-[minmax(0,1.2fr)_minmax(260px,0.8fr)] items-end gap-x-[clamp(3rem,8vw,8rem)] max-[800px]:grid-cols-1 max-[800px]:items-start max-[800px]:gap-y-10">
    <div>
      <h2 class="mb-5 text-[clamp(2.2rem,4.2vw,4.2rem)] font-extrabold leading-[0.98] tracking-[-0.05em] text-balance transition-transform duration-300 group-hover:translate-x-[0.2rem] max-[600px]:text-[clamp(2.1rem,10vw,3.4rem)]">{title}</h2>
      <p class="max-w-[650px] text-[clamp(1rem,1.15vw,1.15rem)] leading-[1.8] text-muted max-[600px]:text-[0.95rem] max-[600px]:leading-[1.75]">{description}</p>
    </div>

    <div>
      <div class="mb-10 flex flex-wrap gap-2 max-[800px]:mb-8">
        {technologies.map((technology) => (
          <span class="border border-line bg-paper px-3 py-1.5 text-[0.65rem] font-semibold uppercase tracking-[0.08em] transition-colors duration-300 group-hover:border-ink/20 max-[600px]:text-[0.6rem]">{technology}</span>
        ))}
      </div>
      <a href={`/projects/${slug}`} class="project-link inline-flex items-center gap-3 border-b border-ink pb-2 text-[0.7rem] font-extrabold uppercase tracking-[0.13em] transition-[gap,opacity] duration-300 hover:gap-5">
        View project <span class="text-base transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</article>
