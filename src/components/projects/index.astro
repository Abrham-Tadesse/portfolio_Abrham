---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../navigation/Navbar.astro";
import Footer from "../Footer.astro";
import ProjectGrid from "./ProjectGrid.astro";
import ContactCTA from "../home/ContactCTA.astro";
---

<BaseLayout title="Projects | Your Name" description="Projects built by Your Name.">
  <Navbar />
  <main>
    <section class="py-32 pb-40 max-[800px]:py-24 max-[800px]:pb-28 max-[600px]:py-20 max-[600px]:pb-24">
      <div class="mx-auto max-w-[1200px] px-6 max-[600px]:px-4">
        <div class="mb-20 flex items-center gap-4 text-[0.8rem] font-bold uppercase tracking-[0.12em] max-[600px]:mb-12">
          <span class="text-[#888]">03</span><span class="text-ink">Projects</span>
        </div>
        <header class="mb-28 grid grid-cols-[1.2fr_0.8fr] gap-24 max-[800px]:mb-20 max-[800px]:grid-cols-1 max-[800px]:gap-8">
          <h1 class="m-0 text-[clamp(2.8rem,6vw,5.5rem)] font-extrabold leading-[0.96] tracking-[-0.05em] max-[600px]:text-[clamp(2.5rem,12vw,4.5rem)]">Things I've built.</h1>
          <p class="max-w-[500px] text-[clamp(1rem,1.15vw,1.15rem)] leading-[1.8]">A collection of projects I've built while learning, experimenting, and solving practical problems.</p>
        </header>
        <ProjectGrid />
      </div>
    </section>
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
