---

<div class="page-transition" aria-hidden="true">
  <div class="transition-content">
    <span class="transition-number">00</span>
    <span class="transition-label">Loading</span>
  </div>
</div>

<script>
  function setupPageTransition() {
    const transition = document.querySelector(".page-transition");
    if (!transition) return;

    // Ensure hidden on initial load
    transition.classList.add("is-hidden");

    // Before navigation starts: slide cover down/in
    document.addEventListener("astro:before-preparation", () => {
      transition.classList.remove("is-hidden");
    });

    // After DOM updates: allow frame render then slide cover away
    document.addEventListener("astro:after-swap", () => {
      requestAnimationFrame(() => {
        transition.classList.add("is-hidden");
      });
    });

    // Fallback safeguard to prevent sticking on loading overlay
    document.addEventListener("astro:page-load", () => {
      transition.classList.add("is-hidden");
    });
  }

  // Initialize lifecycle listener
  setupPageTransition();
  document.addEventListener("astro:after-swap", setupPageTransition);
</script>

<style>
  .page-transition {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0e0e0e;
    pointer-events: none;
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.75s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .page-transition.is-hidden {
    clip-path: inset(0 0 100% 0);
  }

  .transition-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #f4f4f0;
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .transition-number {
    color: #666;
  }
</style>