<div class="page-transition pointer-events-none fixed inset-0 z-[9999] flex items-center justify-center bg-ink text-paper">
  <div class="transition-content flex items-center gap-4 font-heading text-[0.85rem] font-extrabold uppercase tracking-[0.2em]">
    <span class="text-[#666]">00</span>
    <span>Loading</span>
  </div>
</div>

<style>
  .page-transition {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.75s cubic-bezier(0.77, 0, 0.175, 1);
    will-change: clip-path;
  }
  .page-transition.is-visible { clip-path: inset(0 0 0 0); }
  .transition-content { opacity: 0; transform: translateY(10px); transition: opacity 0.35s ease, transform 0.35s ease; }
  .is-visible .transition-content { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .page-transition, .transition-content { transition: none; } }
</style>

<script>
  const showLoader = () => {
    const loader = document.querySelector(".page-transition");
    if (!loader) return;
    loader.classList.add("is-visible");
  };

  const hideLoader = () => {
    const loader = document.querySelector(".page-transition");
    if (!loader) return;
    loader.classList.remove("is-visible");
  };

  hideLoader();
  document.addEventListener("astro:before-preparation", showLoader);
  document.addEventListener("astro:after-swap", () => {
    window.scrollTo(0, 0);
    hideLoader();
  });
  document.addEventListener("astro:page-load", hideLoader);
</script>
