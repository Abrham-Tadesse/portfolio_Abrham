---
import "../styles/global.css";
import PageTransition from "../components/transition/PageTransition.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Personal portfolio of a software developer."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <title>{title}</title>
     <ClientRouter />
  </head>

  <body>
    <PageTransition/>
    <slot />
  </body>
</html>