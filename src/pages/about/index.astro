---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import AboutIntro from "../../components/about/AboutIntro.astro";
import Skills from "../../components/about/Skills.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="About | Abrham Tadesse"
  description="Learn more about Abrham Tadesse, a software developer."
>
  <Navbar />

  <main>
    <AboutIntro />

    <Skills />
  </main>

  <Footer />
</BaseLayout>


<style>
  .about-page {
    padding: 10rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .about-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    margin-bottom: 8rem;
  }

  .about-header h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .about-header p {
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text-muted);
  }

  .about-section {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 4rem;
    padding: 4rem 0;
    border-top: 1px solid var(--border-color);
  }

  .about-section h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .about-section-content p {
    margin: 0 0 1.5rem;
    font-size: 1.1rem;
    line-height: 1.9;
  }

  @media (max-width: 800px) {
    .about-header, .about-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>