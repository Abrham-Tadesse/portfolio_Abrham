---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import AboutIntro from "../../components/about/AboutIntro.astro";
import Skills from "../../components/about/Skills.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="About | Abrham Tadesse" description="Learn more about Abrham Tadesse, a software developer.">
  <Navbar />
  <main class="min-h-screen py-[clamp(10rem,15vw,14rem)] pb-[clamp(7rem,12vw,11rem)] max-[650px]:py-32 max-[650px]:pb-20">
    <div class="mx-auto w-[min(1200px,calc(100%-3rem))] max-[650px]:w-[min(100%-2rem,1200px)]">
      <div class="section-number mb-[clamp(3.5rem,7vw,6rem)] flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.18em] max-[650px]:mb-12">
        <span class="text-muted">01</span><span class="text-ink">About</span>
      </div>

      <header class="mb-[clamp(6rem,11vw,10rem)] grid grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)] items-end gap-[clamp(3rem,8vw,9rem)] border-b border-line pb-[clamp(4rem,7vw,6rem)] max-[900px]:grid-cols-1 max-[900px]:items-start max-[900px]:gap-10 max-[650px]:mb-20 max-[650px]:pb-14">
        <h1 class="m-0 max-w-[850px] text-[clamp(3.2rem,7vw,7rem)] font-extrabold leading-[0.92] tracking-[-0.06em] text-balance max-[650px]:text-[clamp(3rem,14vw,5rem)] max-[650px]:leading-[0.94]">Building thoughtful digital tools.</h1>
        <p class="max-w-[390px] pb-1 text-[clamp(1rem,1.2vw,1.15rem)] leading-[1.85] text-muted max-[900px]:max-w-[600px] max-[900px]:pb-0 max-[650px]:text-base max-[650px]:leading-[1.75]">
          I'm a software developer passionate about building performant, scalable applications and solving complex problems with technology.
        </p>
      </header>
      <div class="about-components">
        <AboutIntro />
        <Skills />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .section-number span:last-child { color: var(--text-main); }
  .section-number::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
  .about-components :global(.about-preview), .about-components :global(.skills) { border-top: 0; }
  .about-components :global(.about-preview > div), .about-components :global(.skills > div) { width: 100%; max-width: none; }
</style>
