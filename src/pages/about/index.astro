---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import AboutIntro from "../../components/about/AboutIntro.astro";
import Skills from "../../components/about/Skills.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="About | Your Name"
  description="Learn more about Your Name, a software developer."
>
  <Navbar />

  <main>
    <AboutIntro />

    <Skills />
  </main>

  <Footer />
</BaseLayout>



<style>
  .about-page {
    padding: 9rem 0 11rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-bottom: 5rem;

    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .section-number span:first-child {
    color: #888;
  }

  .about-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;

    margin-bottom: 9rem;
  }

  .about-header h1 {
    margin: 0;

    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .about-header p {
    max-width: 500px;
    margin: 0;

    font-size: 1.1rem;
    line-height: 1.85;
  }

  .about-section {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 5rem;

    padding: 4rem 0;

    border-top: 1px solid #d8d8d5;
  }

  .about-section h2 {
    margin: 0;

    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .about-section-content {
    max-width: 700px;
  }

  .about-section-content p {
    margin: 0 0 1.5rem;

    font-size: 1.05rem;
    line-height: 1.9;
  }

  @media (max-width: 800px) {
    .about-page {
      padding: 7rem 0 8rem;
    }

    .about-header {
      grid-template-columns: 1fr;
      gap: 2rem;

      margin-bottom: 6rem;
    }

    .about-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1rem;
    }

    .about-page {
      padding: 6rem 0 7rem;
    }

    .section-number {
      margin-bottom: 3rem;
    }

    .about-header h1 {
      font-size: clamp(3.5rem, 16vw, 6rem);
    }
  }
</style>