---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import AboutIntro from "../../components/about/AboutIntro.astro";
import Skills from "../../components/about/Skills.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="About | Abrham Tadesse"
  description="Learn more about Abrham Tadesse, a software developer."
>
  <Navbar />

  <main class="about-page">
    <div class="container">
      <div class="section-number">
        <span>01</span>
        <span>About</span>
      </div>

      <header class="about-header">
        <h1>Building thoughtful digital tools.</h1>
        <p>
          I'm a software developer passionate about building performant, 
          scalable applications and solving complex problems with technology.
        </p>
      </header>

      <AboutIntro />
      <Skills />
    </div>
  </main>

  <Footer />
</BaseLayout>


<style>
  .about-page {
    min-height: 100vh;
    padding: clamp(10rem, 15vw, 14rem) 0 clamp(7rem, 12vw, 11rem);
  }

  .container {
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  /* -------------------------
     Section label
  ------------------------- */

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-bottom: clamp(3.5rem, 7vw, 6rem);

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.72rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .section-number::after {
    content: "";

    width: 3rem;
    height: 1px;

    background: var(--border-color, #dcdcd6);
  }

  .section-number span:first-child {
    color: var(--text-muted, #666660);
  }

  .section-number span:last-child {
    color: var(--text-main, #0e0e0e);
  }

  /* -------------------------
     Page introduction
  ------------------------- */

  .about-header {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);

    gap: clamp(3rem, 8vw, 9rem);

    margin-bottom: clamp(6rem, 11vw, 10rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);

    border-bottom: 1px solid var(--border-color, #dcdcd6);

    align-items: end;
  }

  .about-header h1 {
    max-width: 850px;

    margin: 0;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: clamp(3.2rem, 7vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
    font-weight: 800;

    text-wrap: balance;
  }

  .about-header p {
    max-width: 390px;

    margin: 0;
    padding-bottom: 0.4rem;

    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.85;

    color: var(--text-muted, #666660);
  }

  /* -------------------------
     Content below introduction
  ------------------------- */

  .about-page :global(.about-preview),
  .about-page :global(.skills) {
    border-top: 0;
  }

  /* Prevent nested components from
     creating excessive horizontal spacing */
  .about-page :global(.about-preview .container),
  .about-page :global(.skills .container) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  /* -------------------------
     Responsive
  ------------------------- */

  @media (max-width: 900px) {
    .about-header {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: start;
    }

    .about-header p {
      max-width: 600px;
      padding-bottom: 0;
    }
  }

  @media (max-width: 650px) {
    .about-page {
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .container {
      width: min(100% - 2rem, 1200px);
    }

    .section-number {
      margin-bottom: 3rem;
    }

    .about-header {
      margin-bottom: 5rem;
      padding-bottom: 3.5rem;
    }

    .about-header h1 {
      font-size: clamp(3rem, 14vw, 5rem);
      line-height: 0.94;
    }

    .about-header p {
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-header {
      scroll-behavior: auto;
    }
  }
</style>