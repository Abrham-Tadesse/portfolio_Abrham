---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="Contact | Your Name"
  description="Get in touch with Your Name."
>
  <Navbar />

  <main>
    <section class="contact">
      <div class="container">

        <header class="contact-header">
          <p class="eyebrow">Contact</p>

          <h1>Let's work together.</h1>

          <p>
            Have a project, opportunity, or idea you'd like to discuss?
            Feel free to get in touch.
          </p>
        </header>

        <div class="contact-links">

          <a href="mailto:abrhamtadesseam@gmail.com">
            <span>Email</span>
            <strong>abrhamtadesseam@gmail</strong>
          </a>

          <a
            href="https://github.com/Abrham-Tadesse"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>GitHub</span>
            <strong>github.com/Abrham-Tadesse</strong>
          </a>

          <a
            href="https://www.linkedin.com/in/linkedin/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>LinkedIn</span>
            <strong>linkedin.com/in/linkedin</strong>
          </a>

        </div>

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>


<style>
  .contact {
    min-height: 100vh;

    padding: clamp(10rem, 16vw, 14rem) 0
      clamp(7rem, 12vw, 11rem);

    display: flex;
    align-items: center;
  }

  .container {
    width: min(1000px, calc(100% - 3rem));

    margin: 0 auto;
  }

  /* =========================
     Header
  ========================= */

  .contact-header {
    max-width: 850px;

    margin-bottom: clamp(5rem, 10vw, 8rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin: 0 0 2.5rem;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.7rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.18em;

    color: var(--text-muted);
  }

  .eyebrow::after {
    content: "";

    width: 3rem;
    height: 1px;

    background: var(--border-color);
  }

  .contact-header h1 {
    max-width: 850px;

    margin: 0 0 2.5rem;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 800;

    line-height: 0.88;
    letter-spacing: -0.065em;

    text-wrap: balance;
  }

  .contact-header > p:last-child {
    max-width: 620px;

    margin: 0;

    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.85;

    color: var(--text-muted);
  }

  /* =========================
     Contact Links
  ========================= */

  .contact-links {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
  }

  .contact-links a {
    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: 210px;

    padding: 2rem;

    border-right: 1px solid var(--border-color);

    background: transparent;

    transition:
      background-color 0.4s var(--ease-out, ease),
      color 0.4s var(--ease-out, ease);
  }

  .contact-links a:last-child {
    border-right: 0;
  }

  .contact-links a:hover {
    background: var(--text-main);

    color: var(--bg-color);
  }

  .contact-links span {
    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.68rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.16em;

    color: var(--text-muted);

    transition: color 0.4s ease;
  }

  .contact-links a:hover span {
    color: #888;
  }

  .contact-links strong {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    font-family: var(--font-body, inherit);
    font-size: clamp(0.85rem, 1vw, 1rem);
    font-weight: 600;

    word-break: break-word;
  }

  .contact-links strong::after {
    content: "↗";

    flex-shrink: 0;

    font-family: var(--font-body, inherit);
    font-size: 1rem;

    transition:
      transform 0.35s var(--ease-out, ease);
  }

  .contact-links a:hover strong::after {
    transform: translate(0.2rem, -0.2rem);
  }

  /* =========================
     Responsive
  ========================= */

  @media (max-width: 800px) {
    .contact {
      padding-top: 9rem;
    }

    .contact-links {
      grid-template-columns: 1fr;
    }

    .contact-links a {
      min-height: 170px;

      border-right: 0;
      border-bottom: 1px solid var(--border-color);
    }

    .contact-links a:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 2rem, 1000px);
    }

    .contact {
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .contact-header {
      margin-bottom: 5rem;
    }

    .contact-header h1 {
      font-size: clamp(3.2rem, 16vw, 5rem);
    }

    .contact-header > p:last-child {
      font-size: 1rem;
      line-height: 1.75;
    }

    .contact-links a {
      min-height: 150px;

      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-links a,
    .contact-links span,
    .contact-links strong::after {
      transition: none;
    }
  }
</style>