---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="Contact | Your Name"
  description="Get in touch with Your Name."
>
  <Navbar />

  <main>
    <section class="contact">
      <div class="container">

        <header class="contact-header">
          <p class="eyebrow">Contact</p>

          <h1>Let's work together.</h1>

          <p>
            Have a project, opportunity, or idea you'd like to discuss?
            Feel free to get in touch.
          </p>
        </header>

        <div class="contact-links">

          <a href="mailto:abrhamtadesseam@gmail.com">
            <span>Email</span>
            <strong>abrhamtadesseam@gmail</strong>
          </a>

          <a
            href="https://github.com/Abrham-Tadesse"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>GitHub</span>
            <strong>github.com/Abrham-Tadesse</strong>
          </a>

          <a
            href="https://www.linkedin.com/in/linkedin/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>LinkedIn</span>
            <strong>linkedin.com/in/linkedin</strong>
          </a>

        </div>

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>



<style>
  .contact {
    padding: 10rem 0;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .contact-header {
    max-width: 750px;
    margin-bottom: 6rem;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  h1 {
    margin-bottom: 2rem;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .contact-header > p:last-child {
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .contact-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .contact-links a {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem 2rem;
    border: 1px solid var(--border-color);
    background: #ebebe5;
    transition: all 0.3s ease;
  }

  .contact-links a:hover {
    background: var(--text-main);
    color: var(--bg-color);
    border-color: var(--text-main);
  }

  .contact-links span {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .contact-links strong {
    font-size: 1rem;
    word-break: break-word;
  }

  @media (max-width: 800px) {
    .contact-links {
      grid-template-columns: 1fr;
    }
  }
</style>