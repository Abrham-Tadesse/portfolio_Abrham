---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="Contact | Your Name" description="Get in touch with Your Name.">
  <Navbar />
  <main>
    <section class="flex min-h-screen items-center py-[clamp(10rem,16vw,14rem)] pb-[clamp(7rem,12vw,11rem)] max-[800px]:items-start max-[800px]:pt-36 max-[600px]:py-32 max-[600px]:pb-20">
      <div class="mx-auto w-[min(1000px,calc(100%-3rem))] max-[600px]:w-[min(100%-2rem,1000px)]">
        <header class="mb-[clamp(5rem,10vw,8rem)] max-w-[850px] max-[600px]:mb-20">
          <p class="eyebrow mb-10 flex items-center gap-4 font-heading text-[0.7rem] font-extrabold uppercase tracking-[0.18em] text-muted max-[600px]:mb-5">Contact</p>
          <h1 class="mb-10 max-w-[850px] text-[clamp(2.8rem,6vw,5.8rem)] font-extrabold leading-[0.96] tracking-[-0.055em] text-balance max-[600px]:text-[clamp(2.6rem,12vw,4.4rem)]">Let's work together.</h1>
          <p class="max-w-[620px] text-[clamp(1rem,1.15vw,1.15rem)] leading-[1.8] text-muted max-[600px]:text-base max-[600px]:leading-[1.75]">
            Have a project, opportunity, or idea you'd like to discuss? Feel free to get in touch.
          </p>
        </header>

        <div class="grid grid-cols-3 border-y border-ink max-[800px]:grid-cols-1">
          <a href="mailto:abrhamtadesseam@gmail.com" class="contact-card group flex min-h-[210px] flex-col justify-between border-r border-line p-8 transition-colors duration-300 hover:bg-[#ebebe5] hover:text-ink max-[800px]:min-h-[170px] max-[800px]:border-r-0 max-[800px]:border-b max-[600px]:min-h-[150px] max-[600px]:p-6">
            <span class="font-heading text-[0.68rem] font-extrabold uppercase tracking-[0.16em] text-muted transition-colors group-hover:text-[#888]">Email</span>
            <strong class="contact-address flex items-center justify-between gap-4 break-words font-sans text-[clamp(0.85rem,1vw,1rem)] font-semibold">abrhamtadesseam@gmail</strong>
          </a>
          <a href="https://github.com/Abrham-Tadesse" target="_blank" rel="noopener noreferrer" class="contact-card group flex min-h-[210px] flex-col justify-between border-r border-line p-8 transition-colors duration-300 hover:bg-[#ebebe5] hover:text-ink max-[800px]:min-h-[170px] max-[800px]:border-r-0 max-[800px]:border-b max-[600px]:min-h-[150px] max-[600px]:p-6">
            <span class="font-heading text-[0.68rem] font-extrabold uppercase tracking-[0.16em] text-muted transition-colors group-hover:text-[#888]">GitHub</span>
            <strong class="contact-address flex items-center justify-between gap-4 break-words font-sans text-[clamp(0.85rem,1vw,1rem)] font-semibold">github.com/Abrham-Tadesse</strong>
          </a>
          <a href="https://www.linkedin.com/in/linkedin/" target="_blank" rel="noopener noreferrer" class="contact-card group flex min-h-[210px] flex-col justify-between p-8 transition-colors duration-300 hover:bg-[#ebebe5] hover:text-ink max-[800px]:min-h-[170px] max-[800px]:border-b max-[600px]:min-h-[150px] max-[600px]:p-6">
            <span class="font-heading text-[0.68rem] font-extrabold uppercase tracking-[0.16em] text-muted transition-colors group-hover:text-[#888]">LinkedIn</span>
            <strong class="contact-address flex items-center justify-between gap-4 break-words font-sans text-[clamp(0.85rem,1vw,1rem)] font-semibold">linkedin.com/in/linkedin</strong>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .eyebrow::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
  .contact-address::after { content: "↗"; flex-shrink: 0; font-size: 1rem; transition: transform 0.35s var(--ease-out); }
  .contact-card:hover .contact-address::after { transform: translate(0.2rem, -0.2rem); }
</style>
