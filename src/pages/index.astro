---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/navigation/Navbar.astro";
import Hero from "../components/home/Hero.astro";
import Footer from "../components/Footer.astro";
import AboutIntro from "../components/about/AboutIntro.astro";
import Skills from "../components/about/Skills.astro";
import ContactCTA from "../components/home/ContactCTA.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
---

<BaseLayout
  title="Abrham Tadesse | Software Developer"
  description="Personal portfolio of Abrham Tadesse, a software developer."
>
  <Navbar />

  <main>
    <Hero
      name="Abrham Tadesse"
      role="Software Developer"
      description="I build useful software and solve real-world problems through technology."
    />

    <AboutIntro />
     <Skills />
     <FeaturedProjects /> 
     <ContactCTA />
  </main>

  <Footer />
</BaseLayout>
