---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug
    },
    props: {
      project
    }
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Your Name`}
  description={project.description}
>
  <Navbar />

  <main>
    <article class="project-detail">
      <div class="container">

        <header class="project-header">
          <p class="eyebrow">Project</p>

          <h1>{project.title}</h1>

          <p class="description">
            {project.description}
          </p>

          <div class="links">
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>

            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
              >
                Live Demo
              </a>
            )}
          </div>
        </header>

        <section class="case-study">

          <div class="case-section">
            <h2>The Problem</h2>

            <p>
              {project.problem}
            </p>
          </div>

          <div class="case-section">
            <h2>The Solution</h2>

            <p>
              {project.solution}
            </p>
          </div>

          <div class="case-section">
            <h2>Features</h2>

            <ul>
              {project.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>

          <div class="case-section">
            <h2>Technologies</h2>

            <div class="technologies">
              {project.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </div>

          <div class="case-section">
            <h2>Challenges</h2>

            <ul>
              {project.challenges.map((challenge) => (
                <li>{challenge}</li>
              ))}
            </ul>
          </div>

        </section>

      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>





<style>
  .project-detail {
    min-height: 100vh;

    padding: clamp(10rem, 15vw, 14rem) 0 clamp(7rem, 12vw, 11rem);
  }

  .container {
    width: min(1000px, calc(100% - 3rem));

    margin: 0 auto;
  }

  /* =========================
     Project Header
  ========================= */

  .project-header {
    max-width: 900px;

    margin-bottom: clamp(7rem, 14vw, 12rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin: 0 0 2.5rem;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.7rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.18em;

    color: var(--text-muted);
  }

  .eyebrow::after {
    content: "";

    width: 3rem;
    height: 1px;

    background: var(--border-color);
  }

  .project-header h1 {
    max-width: 900px;

    margin: 0 0 2.5rem;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 800;

    line-height: 0.88;
    letter-spacing: -0.065em;

    text-wrap: balance;
  }

  .description {
    max-width: 650px;

    margin: 0 0 3rem;

    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.8;

    color: var(--text-muted);
  }

  /* =========================
     Project Links
  ========================= */

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 1.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    padding-bottom: 0.5rem;

    border-bottom: 1px solid var(--text-main);

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.7rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.14em;

    transition:
      gap 0.35s var(--ease-out, ease),
      opacity 0.25s ease;
  }

  .links a::after {
    content: "↗";

    font-size: 0.85rem;

    transition: transform 0.35s var(--ease-out, ease);
  }

  .links a:hover {
    gap: 0.9rem;
  }

  .links a:hover::after {
    transform: translate(0.15rem, -0.15rem);
  }

  /* =========================
     Case Study
  ========================= */

  .case-study {
    border-top: 1px solid var(--border-dark);

    padding-top: clamp(4rem, 7vw, 6rem);
  }

  .case-section {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);

    gap: clamp(2rem, 6vw, 6rem);

    padding: clamp(3rem, 6vw, 5rem) 0;

    border-bottom: 1px solid var(--border-color);
  }

  .case-section:last-child {
    border-bottom: 0;
  }

  .case-section h2 {
    position: relative;

    margin: 0;

    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.75rem;
    font-weight: 800;

    line-height: 1.4;

    text-transform: uppercase;
    letter-spacing: 0.16em;

    color: var(--text-muted);
  }

  .case-section h2::before {
    content: "—";

    margin-right: 0.5rem;

    color: var(--text-main);
  }

  .case-section p {
    max-width: 680px;

    margin: 0;

    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.9;

    color: var(--text-main);
  }

  /* =========================
     Lists
  ========================= */

  .case-section ul {
    display: flex;
    flex-direction: column;

    gap: 1.25rem;

    max-width: 680px;

    margin: 0;

    padding: 0;

    list-style: none;
  }

  .case-section li {
    position: relative;

    padding-left: 1.5rem;

    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.8;

    color: var(--text-main);
  }

  .case-section li::before {
    content: "→";

    position: absolute;
    left: 0;
    top: 0;

    color: var(--text-muted);
  }

  /* =========================
     Technologies
  ========================= */

  .technologies {
    display: flex;
    flex-wrap: wrap;

    gap: 0.6rem;

    max-width: 680px;
  }

  .technologies span {
    padding: 0.5rem 0.85rem;

    border: 1px solid var(--border-color);

    background: #ebebe5;

    font-size: 0.68rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.08em;

    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .technologies span:hover {
    background: var(--text-main);
    border-color: var(--text-main);
    color: var(--bg-color);
  }

  /* =========================
     Responsive
  ========================= */

  @media (max-width: 800px) {
    .container {
      width: min(100% - 2rem, 1000px);
    }

    .case-section {
      grid-template-columns: 1fr;

      gap: 1.75rem;
    }

    .case-section h2 {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 600px) {
    .project-detail {
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .project-header {
      margin-bottom: 6rem;
    }

    .eyebrow {
      margin-bottom: 2rem;
    }

    .project-header h1 {
      font-size: clamp(3.2rem, 16vw, 5rem);
    }

    .description {
      font-size: 1rem;
      line-height: 1.75;
    }

    .case-section {
      padding: 3rem 0;
    }

    .case-section p,
    .case-section li {
      font-size: 0.98rem;
      line-height: 1.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links a,
    .links a::after,
    .technologies span {
      transition: none;
    }
  }
</style>