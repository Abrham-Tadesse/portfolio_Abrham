---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug
    },
    props: {
      project
    }
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Your Name`}
  description={project.description}
>
  <Navbar />

  <main>
    <article class="project-detail">
      <div class="container">

        <header class="project-header">
          <p class="eyebrow">Project</p>

          <h1>{project.title}</h1>

          <p class="description">
            {project.description}
          </p>

          <div class="links">
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>

            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
              >
                Live Demo
              </a>
            )}
          </div>
        </header>

        <section class="case-study">

          <div class="case-section">
            <h2>The Problem</h2>

            <p>
              {project.problem}
            </p>
          </div>

          <div class="case-section">
            <h2>The Solution</h2>

            <p>
              {project.solution}
            </p>
          </div>

          <div class="case-section">
            <h2>Features</h2>

            <ul>
              {project.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>

          <div class="case-section">
            <h2>Technologies</h2>

            <div class="technologies">
              {project.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </div>

          <div class="case-section">
            <h2>Challenges</h2>

            <ul>
              {project.challenges.map((challenge) => (
                <li>{challenge}</li>
              ))}
            </ul>
          </div>

        </section>

      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>






<style>
  .project-detail {
    padding: 10rem 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .project-header {
    margin-bottom: 7rem;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  h1 {
    margin-bottom: 2rem;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .description {
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .links {
    display: flex;
    gap: 2rem;
  }

  .links a {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 0.25rem;
    transition: opacity 0.25s ease;
  }

  .links a:hover {
    opacity: 0.6;
  }

  .case-study {
    border-top: 1px solid var(--border-dark);
    padding-top: 5rem;
  }

  .case-section {
    margin-bottom: 5rem;
  }

  .case-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .case-section p {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-main);
  }

  .case-section ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 1.25rem;
  }

  .case-section li {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .technologies span {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border-color);
    background: #ebebe5;
    font-size: 0.8rem;
  }
</style>