---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} | Your Name`} description={project.description}>
  <Navbar />
  <main>
    <article class="min-h-screen py-[clamp(10rem,15vw,14rem)] pb-[clamp(7rem,12vw,11rem)]">
      <div class="mx-auto w-[min(1000px,calc(100%-3rem))] max-[600px]:w-[min(100%-2rem,1000px)]">
        <header class="mb-[clamp(7rem,14vw,12rem)] max-w-[900px]">
          <p class="eyebrow mb-10 flex items-center gap-4 font-heading text-[0.7rem] font-extrabold uppercase tracking-[0.18em] text-muted max-[600px]:mb-5">Project</p>
          <h1 class="mb-10 max-w-[900px] text-[clamp(3.5rem,9vw,8rem)] font-extrabold leading-[0.88] tracking-[-0.065em] text-balance max-[600px]:text-[clamp(3.2rem,16vw,5rem)]">{project.title}</h1>
          <p class="mb-12 max-w-[650px] text-[clamp(1.05rem,1.35vw,1.25rem)] leading-[1.8] text-muted">{project.description}</p>
          <div class="flex flex-wrap items-center gap-6">
            <a class="project-external-link inline-flex items-center gap-2 border-b border-ink pb-2 font-heading text-[0.7rem] font-extrabold uppercase tracking-[0.14em] transition-[gap,opacity] duration-300 hover:gap-4" href={project.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            {project.demo && <a class="project-external-link inline-flex items-center gap-2 border-b border-ink pb-2 font-heading text-[0.7rem] font-extrabold uppercase tracking-[0.14em] transition-[gap,opacity] duration-300 hover:gap-4" href={project.demo} target="_blank" rel="noopener noreferrer">Live Demo</a>}
          </div>
        </header>

        <section class="border-t border-ink pt-[clamp(4rem,7vw,6rem)]">
          <div class="case-section grid grid-cols-[240px_minmax(0,1fr)] gap-[clamp(2rem,6vw,6rem)] border-b border-line py-[clamp(3rem,6vw,5rem)] max-[800px]:grid-cols-1 max-[800px]:gap-6">
            <h2 class="case-heading relative m-0 font-heading text-xs font-extrabold uppercase leading-[1.4] tracking-[0.16em] text-muted">The Problem</h2>
            <p class="max-w-[680px] text-[clamp(1rem,1.2vw,1.1rem)] leading-[1.9] text-ink">{project.problem}</p>
          </div>
          <div class="case-section grid grid-cols-[240px_minmax(0,1fr)] gap-[clamp(2rem,6vw,6rem)] border-b border-line py-[clamp(3rem,6vw,5rem)] max-[800px]:grid-cols-1 max-[800px]:gap-6">
            <h2 class="case-heading relative m-0 font-heading text-xs font-extrabold uppercase leading-[1.4] tracking-[0.16em] text-muted">The Solution</h2>
            <p class="max-w-[680px] text-[clamp(1rem,1.2vw,1.1rem)] leading-[1.9] text-ink">{project.solution}</p>
          </div>
          <div class="case-section grid grid-cols-[240px_minmax(0,1fr)] gap-[clamp(2rem,6vw,6rem)] border-b border-line py-[clamp(3rem,6vw,5rem)] max-[800px]:grid-cols-1 max-[800px]:gap-6">
            <h2 class="case-heading relative m-0 font-heading text-xs font-extrabold uppercase leading-[1.4] tracking-[0.16em] text-muted">Features</h2>
            <ul class="case-list m-0 flex max-w-[680px] list-none flex-col gap-5 p-0 text-[clamp(1rem,1.2vw,1.1rem)] leading-[1.8]">
              {project.features.map((feature) => <li class="relative pl-6">{feature}</li>)}
            </ul>
          </div>
          <div class="case-section grid grid-cols-[240px_minmax(0,1fr)] gap-[clamp(2rem,6vw,6rem)] border-b border-line py-[clamp(3rem,6vw,5rem)] max-[800px]:grid-cols-1 max-[800px]:gap-6">
            <h2 class="case-heading relative m-0 font-heading text-xs font-extrabold uppercase leading-[1.4] tracking-[0.16em] text-muted">Technologies</h2>
            <div class="flex max-w-[680px] flex-wrap gap-2">
              {project.technologies.map((technology) => <span class="border border-line px-3 py-2 text-[0.68rem] font-bold uppercase tracking-[0.1em]">{technology}</span>)}
            </div>
          </div>
          <div class="case-section grid grid-cols-[240px_minmax(0,1fr)] gap-[clamp(2rem,6vw,6rem)] border-b border-line py-[clamp(3rem,6vw,5rem)] last:border-b-0 max-[800px]:grid-cols-1 max-[800px]:gap-6">
            <h2 class="case-heading relative m-0 font-heading text-xs font-extrabold uppercase leading-[1.4] tracking-[0.16em] text-muted">Challenges</h2>
            <ul class="case-list m-0 flex max-w-[680px] list-none flex-col gap-5 p-0 text-[clamp(1rem,1.2vw,1.1rem)] leading-[1.8]">
              {project.challenges.map((challenge) => <li class="relative pl-6">{challenge}</li>)}
            </ul>
          </div>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .eyebrow::after { content: ""; width: 3rem; height: 1px; background: var(--border-color); }
  .project-external-link::after { content: "↗"; font-size: 0.85rem; transition: transform 0.35s var(--ease-out); }
  .project-external-link:hover::after { transform: translate(0.15rem, -0.15rem); }
  .case-heading::before { content: "—"; margin-right: 0.5rem; color: var(--text-main); }
  .case-list li::before { content: "→"; position: absolute; left: 0; color: var(--text-muted); }
</style>
