---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectGrid from "../../components/projects/ProjectGrid.astro";


---

<BaseLayout
  title="Projects | Abrham Tadesse"
  description="Projects built by Abrham Tadesse."
>
  <Navbar />

  <main>
    <section class="projects-page">
      <div class="container">

        <header class="page-header">
          <p class="eyebrow">My Work</p>

          <h1>Projects</h1>

          <p>
            A collection of software projects I've built while learning,
            experimenting, and solving practical problems.
          </p>
        </header>

        <ProjectGrid />

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>




<style>
  .projects-page {
    min-height: 100vh;
    padding: clamp(10rem, 15vw, 14rem) 0 clamp(7rem, 12vw, 11rem);
  }

  .container {
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  /* -------------------------
     Page header
  ------------------------- */

  .page-header {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  column-gap: 6rem;
  row-gap: 3rem;
  margin-bottom: 7rem;
}

  .page-header .eyebrow {
  grid-column: 1 / -1;
  margin: 0;
}

  .page-header h1 {
  grid-column: 1;
  margin: 0;
  font-size: clamp(3.5rem, 8vw, 7rem);
  line-height: 0.9;
  letter-spacing: -0.05em;
}
.page-header > p:last-child {
  grid-column: 2;
  align-self: end;
  margin: 0;
  font-size: 1.15rem;
  line-height: 1.85;
  color: var(--text-muted);
}





  
  /* -------------------------
     Project grid
  ------------------------- */

  .projects-page :global(.project-grid) {
    width: 100%;
  }

  /* -------------------------
     Responsive
  ------------------------- */

  @media (max-width: 900px) {
    .page-header {
      grid-template-columns: 1fr;

      gap: 2.5rem;

      align-items: start;
    }

    .page-header > p:last-child {
      max-width: 600px;
      padding-bottom: 0;
    }
  }

  @media (max-width: 650px) {
    .projects-page {
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .container {
      width: min(100% - 2rem, 1200px);
    }

    .page-header {
      margin-bottom: 5rem;
      padding-bottom: 3.5rem;
    }

    .eyebrow {
      margin-bottom: 1.25rem;
    }

    h1 {
      font-size: clamp(3.5rem, 17vw, 6rem);
      line-height: 0.9;
    }

    .page-header > p:last-child {
      font-size: 1rem;
      line-height: 1.75;
    }
  }
</style>