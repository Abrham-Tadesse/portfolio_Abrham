---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectGrid from "../../components/projects/ProjectGrid.astro";
---

<BaseLayout title="Projects | Abrham Tadesse" description="Projects built by Abrham Tadesse.">
  <Navbar />
  <main>
    <section class="min-h-screen py-[clamp(10rem,15vw,14rem)] pb-[clamp(7rem,12vw,11rem)] max-[650px]:py-32 max-[650px]:pb-20">
      <div class="mx-auto w-[min(1200px,calc(100%-3rem))] max-[650px]:w-[min(100%-2rem,1200px)]">
        <header class="mb-28 grid grid-cols-[1.2fr_0.8fr] gap-x-24 gap-y-12 max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[650px]:mb-20">
          <p class="col-span-full m-0 flex items-center gap-4 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.18em] text-muted max-[900px]:col-span-1 max-[650px]:mb-1">My Work <span class="inline-block h-px w-12 bg-line"></span></p>
          <h1 class="col-start-1 m-0 text-[clamp(2.8rem,6vw,5.5rem)] font-extrabold leading-[0.96] tracking-[-0.05em] max-[650px]:text-[clamp(2.6rem,12vw,4.5rem)]">Projects</h1>
          <p class="col-start-2 row-start-2 self-end text-[clamp(1rem,1.15vw,1.15rem)] leading-[1.8] text-muted max-[900px]:col-start-1 max-[900px]:row-start-auto max-[900px]:max-w-[600px] max-[650px]:text-base max-[650px]:leading-[1.75]">
            A collection of software projects I've built while learning, experimenting, and solving practical problems.
          </p>
        </header>
        <ProjectGrid />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
