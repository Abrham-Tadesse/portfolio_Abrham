---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectGrid from "../../components/projects/ProjectGrid.astro";


---

<BaseLayout
  title="Projects | Your Name"
  description="Projects built by Your Name."
>
  <Navbar />

  <main>
    <section class="projects-page">
      <div class="container">

        <header class="page-header">
          <p class="eyebrow">My Work</p>

          <h1>Projects</h1>

          <p>
            A collection of software projects I've built while learning,
            experimenting, and solving practical problems.
          </p>
        </header>

        <ProjectGrid />

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>


<style>
  .projects-page {
    padding: 9rem 0 11rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-bottom: 5rem;

    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .section-number span:first-child {
    color: #888;
  }

  .page-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;

    margin-bottom: 8rem;
  }

  .page-header h1 {
    margin: 0;

    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .page-header p {
    max-width: 500px;
    margin: 0;

    font-size: 1.1rem;
    line-height: 1.85;
  }

  @media (max-width: 800px) {
    .projects-page {
      padding: 7rem 0 8rem;
    }

    .page-header {
      grid-template-columns: 1fr;
      gap: 2rem;

      margin-bottom: 6rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1rem;
    }

    .projects-page {
      padding: 6rem 0 7rem;
    }

    .section-number {
      margin-bottom: 3rem;
    }

    .page-header h1 {
      font-size: clamp(3.5rem, 16vw, 6rem);
    }
  }
</style>