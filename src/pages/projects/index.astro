---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/navigation/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectGrid from "../../components/projects/ProjectGrid.astro";


---

<BaseLayout
  title="Projects | Abrham Tadesse"
  description="Projects built by Abrham Tadesse."
>
  <Navbar />

  <main>
    <section class="projects-page">
      <div class="container">

        <header class="page-header">
          <p class="eyebrow">My Work</p>

          <h1>Projects</h1>

          <p>
            A collection of software projects I've built while learning,
            experimenting, and solving practical problems.
          </p>
        </header>

        <ProjectGrid />

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>



<style>
  .projects-page {
    padding: 10rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-number {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .section-number span:first-child {
    color: var(--text-muted);
  }

  .page-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    margin-bottom: 7rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .page-header p {
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    .page-header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>